<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main-content" class="page">
    <h1>Experiences</h1>
    <p class="section-lead">
      Alongside the tanks themselves, each zone has activities you can take part in -
      hands-on stations, working models and talks given by the team who care for the animals.
      Talks run at fixed times; everything else is open throughout the day.
    </p>

    <div class="filter" data-filter>
      <h2 class="filter__heading" id="filter-heading">Filter by type</h2>
      <div class="filter__controls" role="group" aria-labelledby="filter-heading">
        <button type="button" class="filter__button is-active" data-filter-value="all" aria-pressed="true">All</button>
        <button type="button" class="filter__button" data-filter-value="Tank exhibit" aria-pressed="false">Tank exhibits</button>
        <button type="button" class="filter__button" data-filter-value="Interactive" aria-pressed="false">Interactive</button>
        <button type="button" class="filter__button" data-filter-value="Hands-on" aria-pressed="false">Hands-on</button>
        <button type="button" class="filter__button" data-filter-value="Talk" aria-pressed="false">Talks</button>
      </div>
      <p class="filter__status" role="status" data-filter-status></p>
    </div>

    <% Object.entries(byZone).forEach(([zoneName, zone]) => { %>
      <section class="experience-zone" aria-labelledby="zone-<%= zone.slug %>" data-zone-section>
        <h2 id="zone-<%= zone.slug %>" class="experience-zone__heading">
          <a href="/zones/<%= zone.slug %>"><%= zoneName %></a>
        </h2>

        <ul class="experience-list">
          <% zone.items.forEach(experience => { %>
            <li class="experience" data-type="<%= experience.type %>">
              <div class="experience__header">
                <h3 class="experience__name"><%= experience.name %></h3>
                <p class="experience__type"><%= experience.type %></p>
              </div>

              <p class="experience__description"><%= experience.description %></p>

              <dl class="experience__meta">
                <% if (experience.duration) { %>
                  <div class="experience__meta-row">
                    <dt>Timing</dt>
                    <dd><%= experience.duration %></dd>
                  </div>
                <% } %>
                <% if (experience.accessibility) { %>
                  <div class="experience__meta-row">
                    <dt>Access</dt>
                    <dd><%= experience.accessibility %></dd>
                  </div>
                <% } %>
                <% if (experience.sensory_note) { %>
                  <div class="experience__meta-row">
                    <dt>What to expect</dt>
                    <dd><%= experience.sensory_note %></dd>
                  </div>
                <% } %>
              </dl>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>