<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="/">
       <a class="site-logo" href="/">
      <img class="site-logo__mark" src="/images/logo.svg" alt="" width="40" height="40">
      <span class="site-logo__text"><%= siteName %></span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="site-nav__list">
        <%
          const navLinks = [
            { href: '/', label: 'Home' },
            { href: '/zones', label: 'Zones' },
            { href: '/experiences', label: 'Experiences' },
            { href: '/rockpool-explorer', label: 'Rockpool Explorer' },
            { href: '/faq', label: 'FAQ' },
            { href: '/contact', label: 'Contact' }
          ];
        %>
            <% navLinks.forEach(link => { %>
          <li>
            <a href="<%= link.href %>"
               class="site-nav__link<%= currentPath === link.href ? ' is-active' : '' %>"
               <% if (currentPath === link.href) { %>aria-current="page"<% } %>>
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>
    </nav>
  </div>
</header>

<div class="opening-bar is-spotlight" id="opening-bar">
  <div class="opening-bar__inner">
    <p class="opening-bar__text">
      <strong>Open <%= openingTimes.days %></strong>
      <span class="opening-bar__hours">
        <time datetime="09:00"><%= openingTimes.open %></time> &ndash;
        <time datetime="18:00"><%= openingTimes.close %></time>
      </span>
    </p>
  </div>
</div>